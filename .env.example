# ==============================================================================
# AI Systems Engineering — Environment Variables Template
#
# Copy this file to `.env` at the repository root and fill in the keys you need:
#   cp .env.example .env
#
# Note: `.env` files are strictly git-ignored across the entire repository.
# `python-dotenv` (`load_dotenv()`) automatically locates the root `.env` file
# when running scripts inside any episode subdirectory.
# ==============================================================================

# --- Core LLM Providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Optional Gateways / Fast Inference (Routing & Fallbacks) ---
OPENROUTER_API_KEY=
GROQ_API_KEY=

# --- Layer 2: RAG, Embeddings, Reranking & Search Tools ---
COHERE_API_KEY=
TAVILY_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=

# --- Layer 4: Observability, Distributed Tracing & Evals ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGSMITH_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

